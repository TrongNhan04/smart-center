// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============ 1. USER & AUTH ============//
enum Vaitro {
  ADMIN
  TEACHER
  PARENT
}

model User {
  ID            Int     @id @default(autoincrement())
  HoTen         String?
  Email         String  @unique
  DienThoai     String  @unique
  MatKhauHash   String
  PhaiDoiMK     Boolean @default(true) //bắt buộc đổi mật khẩu lần đầu đăng nhập
  VaiTro        Vaitro
  PhienBanToken Int     @default(0)

  CreatedAt DateTime @default(now()) @db.Timestamptz(3)
  UpdatedAt DateTime @updatedAt @db.Timestamptz(3)

  //Quan hệ
  GiaoVien GiaoVien? //là giáo viên
  HocVien  HocVien[] //phụ huynh của nhiều học viên
  ThongBao ThongBao[] // thông báo của ai
  GiaoDich GiaoDich[] // ai tạo giao dịch
}

// ============ 2. GIAOVIEN ============//
enum TrangThaiGV {
  ACTIVE
  INACTIVE
}

model GiaoVien {
  ID         Int    @id @default(autoincrement())
  MaGiaoVien String @unique
  UserID     Int    @unique

  NgaySinh  DateTime    @db.Timestamptz(3)
  DiaChi    String?
  ChuyenMon String?
  TrangThai TrangThaiGV @default(ACTIVE) //thêm mới là ACTIVE
  CreatedAt DateTime    @default(now()) @db.Timestamptz(3)
  UpdatedAt DateTime    @updatedAt @db.Timestamptz(3)

  //Quan hệ
  User           User             @relation(fields: [UserID], references: [ID])
  LopHoc         LopHoc[] //giáo viên dạy nhiều lớp học
  KetQua_BuoiHoc KetQua_BuoiHoc[] //giáo viên ghi kết quả nhiều buổi học
}

// ============ 3. HOCVIEN ============//
enum TrangThaiHV {
  ACTIVE
  INACTIVE
}

model HocVien {
  ID        Int    @id @default(autoincrement())
  MaHocVien String @unique
  UserID    Int //id phụ huynh

  TenHocVien String
  NgaySinh   DateTime    @db.Timestamptz(3)
  DiaChi     String?
  GhiChu     String?
  TrangThai  TrangThaiHV @default(ACTIVE) //thêm mới là ACTIVE

  CreatedAt DateTime @default(now()) @db.Timestamptz(3)
  UpdatedAt DateTime @updatedAt @db.Timestamptz(3)

  //Quan hệ
  Parent  User      @relation(fields: [UserID], references: [ID])
  Ghidanh GhiDanh[] //học viên ghi danh nhiều lần
  hoaDons HoaDon[] // học viên có nhiều hóa đơn

  // index
  @@index([TenHocVien])
}

// ============ 4. KHOAHOC ============//
enum TrangThaiKH {
  DRAFT
  ACTIVE
  INACTIVE
}

model KhoaHoc {
  ID        Int    @id @default(autoincrement())
  MaKhoaHoc String @unique

  TenKhoaHoc String
  TrinhDo    String
  ThoiGian   Int //tổng thời gian khóa học (tháng)
  TongSoBuoi Int
  HocPhi     Decimal     @db.Decimal(10, 2)
  TrangThai  TrangThaiKH @default(DRAFT) //mặc định là DRAFT
  MoTa       String?

  CreatedAt DateTime @default(now()) @db.Timestamptz(3)
  UpdatedAt DateTime @updatedAt @db.Timestamptz(3)

  //Quan hệ
  lophoc LopHoc[] //khóa học có nhiều lớp học
  decuong DeCuong[] // lớp học có nhiều đề cương
}

// ============ 5. DECUONG ============//
model DeCuong {
  ID        Int @id @default(autoincrement())
  KhoaHocID Int

  ThuTu Int
  ChuDe String

  // quan hệ
  khoahoc KhoaHoc @relation(fields: [KhoaHocID], references: [ID])
}

// ============ 6. LOPHOC ============//
enum TrangThaiLH {
  OPEN
  RUNNING
  CLOSED
}

model LopHoc {
  ID Int @id @default(autoincrement())

  MaLopHoc   String @unique
  KhoaHocID  Int
  GiaoVienID Int

  TenLop     String
  MoTa       String?
  TuNgay     DateTime    @db.Timestamptz(3)
  DenNgay    DateTime    @db.Timestamptz(3)
  LichHoc    Int[] //[1,3,5] Thứ 2,4,6
  GioBatDau  String //"18:00"
  GioKetThuc String //"20:00"
  SiSo       Int
  PhongHoc   String?
  TrangThai  TrangThaiLH @default(OPEN) //mặc định là OPEN
  CreatedAt  DateTime    @default(now()) @db.Timestamptz(3)
  UpdatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  //Quan hệ
  khoahoc  KhoaHoc   @relation(fields: [KhoaHocID], references: [ID]) // lớp học thuộc về khóa học
  giaovien GiaoVien  @relation(fields: [GiaoVienID], references: [ID]) // lớp học do giáo viên phụ trách
  buoihoc  BuoiHoc[] //lớp học có nhiều buổi học
  ghidanh  GhiDanh[] // lớp học có nhiều học viên ghi danh
}

// ============ 7. BUOIHOC ============//
enum TrangThaiBH {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model BuoiHoc {
  ID       Int @id @default(autoincrement())
  LopHocID Int

  BuoiSo       Int
  ChuDe        String?
  BatDauLuc    DateTime    @db.Timestamptz(3)
  KetThucLuc   DateTime    @db.Timestamptz(3)
  PhongHoc     String?
  AdminMoKhoa  Boolean     @default(false)
  YeuCauMoKhoa Boolean     @default(false)
  LyDoMoKhoa   String?
  NgayYeuCau   DateTime?   @db.Timestamptz(3)
  TrangThai    TrangThaiBH @default(SCHEDULED) //mặc định là SCHEDULE

  CreatedAt      DateTime        @default(now()) @db.Timestamptz(3)
  UpdatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  lophoc         LopHoc          @relation(fields: [LopHocID], references: [ID]) //buổi học thuộc về lớp học
  ketqua_buoihoc KetQua_BuoiHoc? //buổi học có kết quả buổi học

  //Quan hệ
  @@unique([LopHocID, BatDauLuc]) //một lớp học không có hai buổi học cùng ngày + giờ bắt đầu
}

// ============ 8. KETQUA_BUOIHOC ============//
enum TrangThai_KQBH {
  DRAFT
  SUBMITTED
}

model KetQua_BuoiHoc {
  ID         Int @id @default(autoincrement())
  BuoiHocID  Int @unique
  GiaoVienID Int

  NoiDungBaiHoc String?
  BaiTapVeNha   String?
  NhanXetChung  String
  TrangThai     TrangThai_KQBH @default(DRAFT) //mặc định là DRAFT

  CreatedAt DateTime @default(now()) @db.Timestamptz(3)
  UpdatedAt DateTime @updatedAt @db.Timestamptz(3)

  //Quan hệ
  buoihoc        BuoiHoc              @relation(fields: [BuoiHocID], references: [ID])
  giaovien       GiaoVien             @relation(fields: [GiaoVienID], references: [ID])
  ketqua_chitiet KetQua_ChiTiet[] //kết quả buổi học có nhiều kết quả chi tiết
  tep_dinhkem    TepDinhKem_BuoiHoc[] // 1 buổi học có thế có nhiều tệp đính kèm
}

// ============ 9. TEPDINHKEM ============//

model TepDinhKem_BuoiHoc {
  ID          Int @id @default(autoincrement())
  KQBuoiHocID Int

  TepID   String
  URL     String
  LoaiTep String

  CreatedAt DateTime @default(now()) @db.Timestamptz(3)
  UpdatedAt DateTime @updatedAt @db.Timestamptz(3)

  ketqua_buoihoc KetQua_BuoiHoc @relation(fields: [KQBuoiHocID], references: [ID])
}

// ============ 10. KETQUA_CHITIET ============//
model KetQua_ChiTiet {
  ID           Int      @id @default(autoincrement())
  KetQuaID     Int
  GhiDanhID    Int
  NhanXetRieng String?
  DiemDanh     Boolean
  Diem         Decimal? @db.Decimal(4, 2)

  CreatedAt      DateTime       @default(now()) @db.Timestamptz(3)
  UpdatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  ketqua_buoihoc KetQua_BuoiHoc @relation(fields: [KetQuaID], references: [ID])
  ghidanh        GhiDanh        @relation(fields: [GhiDanhID], references: [ID])

  //Quan hệ
  @@unique([KetQuaID, GhiDanhID]) //một kết quả buổi học chỉ có một chi tiết cho mỗi ghi danh 
}

// ============ 11. GHIDANH ============//
enum TrangThai_GD {
  ACTIVE
  INACTIVE
}

model GhiDanh {
  ID        Int @id @default(autoincrement())
  HocVienID Int
  LopHocID  Int

  NgayGhiDanh DateTime     @db.Timestamptz(3)
  GhiChu      String?
  TrangThai   TrangThai_GD @default(ACTIVE)

  CreatedAt      DateTime         @default(now()) @db.Timestamptz(3)
  UpdatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  hocvien        HocVien          @relation(fields: [HocVienID], references: [ID])
  lophoc         LopHoc           @relation(fields: [LopHocID], references: [ID])
  ketqua_chitiet KetQua_ChiTiet[] //ghi danh có nhiều kết quả chi tiết
  hoadon         HoaDon? //1 ghi danh có 1 hóa đơn
}

// ============ 12. HOADON  ============//
enum TrangThai_HD {
  ACTIVE
  CANCELLED
}

model HoaDon {
  ID        Int    @id @default(autoincrement())
  MaHoaDon  String @unique
  GhiDanhID Int?   @unique
  HocVienID Int

  TongTien  Decimal      @db.Decimal(10, 2)
  DaTra     Decimal      @default(0) @db.Decimal(10, 2)
  ThoiHan   DateTime     @db.Timestamptz(3)
  GhiChu    String?
  TrangThai TrangThai_HD @default(ACTIVE)

  CreatedAt DateTime @default(now()) @db.Timestamptz(3)
  UpdatedAt DateTime @updatedAt @db.Timestamptz(3)

  //Quan hệ             
  ghidanh  GhiDanh?   @relation(fields: [GhiDanhID], references: [ID]) // trả tiền cho ghi danh nào
  hocvien  HocVien    @relation(fields: [HocVienID], references: [ID]) // hóa đơn của ai
  giaodich GiaoDich[] //hóa đơn có nhiều giao dich
}

// ============ 13. GIAODICH  ============//
model GiaoDich {
  ID       Int  @id @default(autoincrement())
  UserID   Int
  HoaDonID Int? // có giao dịch không phải trả tiền cho hóa đơn

  MaGiaoDich   String   @unique
  LoaiGiaoDich String
  SoTien       Decimal  @db.Decimal(10, 2)
  NgayGiaoDich DateTime @db.Timestamptz(3)
  PhuongThuc   String?
  GhiChu       String?

  CreatedAt DateTime @default(now()) @db.Timestamptz(3)
  UpdatedAt DateTime @updatedAt @db.Timestamptz(3)

  //Quan hệ
  hoadon HoaDon? @relation(fields: [HoaDonID], references: [ID])
  user   User    @relation(fields: [UserID], references: [ID])
}

// ============ 14. THONGBAO  ============//
model ThongBao {
  ID Int @id @default(autoincrement())

  UserID    Int
  TieuDe    String
  NoiDung   String
  Loai      String
  DuLieu    Json
  DaDoc     Boolean  @default(false) // false = chưa đọc
  CreatedAt DateTime @default(now()) @db.Timestamptz(3)
  UpdatedAt DateTime @updatedAt()

  //quan hệ
  User User @relation(fields: [UserID], references: [ID])
}